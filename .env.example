# GitHub App used by the "Edit with AI" chat editor to commit approved changes and
# power the History tab (list/revert). See README.md for how to create the App.
# All four of these must be set together, or the chat's Save and the History tab will
# fail with a clear "isn't configured" error (the rest of the app works fine without them).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_OWNER=
GITHUB_REPO=

# Optional: commit author email used for chat-driven commits. Defaults to
# architecture-chatbot@example.com if unset.
CHAT_BOT_EMAIL=

# Optional: override the chat's model (AI SDK Gateway provider/model syntax).
# Defaults to openai/gpt-5-mini. On Vercel, Gateway auth is automatic via
# VERCEL_OIDC_TOKEN — no separate provider API key is needed in this app.
CHAT_MODEL=
